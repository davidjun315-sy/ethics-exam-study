# =====================================================================
# ethics-exam-study 환경변수 예시
# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요.  (cp .env.example .env.local)
# .env.local 은 .gitignore 에 포함되어 GitHub 에 올라가지 않습니다.
# 실제 Key / 비밀번호를 이 파일(.env.example)에 적지 마세요.
# =====================================================================

# --- Supabase (Project Settings → API) ---
# 브라우저에도 노출되는 공개 값 (RLS 로 읽기만 허용됨)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# --- 관리자 ---
# /admin 진입 시 입력할 비밀번호 (서버에서만 검증)
ADMIN_PASSWORD=
# (선택) 관리자 세션 쿠키 서명용 비밀값. 비워 두면 ADMIN_PASSWORD 에서 파생됩니다.
# 예: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- AI ---
# anthropic 또는 openai
AI_PROVIDER=anthropic
# 비워 두면 기본값: anthropic → claude-opus-5-5, openai → gpt-5
AI_MODEL=
# (선택, anthropic 전용) low | medium | high | xhigh | max   기본값 high
AI_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# (선택) false 로 두면 'AI 채점'을 관리자 로그인 상태에서만 사용할 수 있습니다. 기본값 true
PUBLIC_AI_GRADING=
